# ==========================================
# HealthAI Assistant Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=HealthAI-Assistant
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_super_secret_64_char_random_key_in_production
WEBHOOK_SECRET=healthai_webhook_secret_for_n8n_and_openwa

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_7fvL3UPlkTpa@ep-dry-moon-bduh6s9f-pooler.c-8.us-east-2.aws.neon.tech/neondb?ssl=require
SYNC_DATABASE_URL=postgresql://neondb_owner:npg_7fvL3UPlkTpa@ep-dry-moon-bduh6s9f-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# n8n Orchestration Engine (Self-Hosted on Geetrix)
N8N_BASE_URL=https://n8n.geetrix.com
WEBHOOK_URL=https://n8n.geetrix.com/

# OpenWA WhatsApp Gateway (Bundled Dashboard & API on port 2785)
OPENWA_PORT=2785
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=openwa_secure_api_key_123
OPENWA_WEBHOOK_URL=http://localhost:8001/api/v1/chat/message
OPENWA_SESSION_NAME=clinic-assistant

# LLM / Ollama Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Calendar Configuration
GOOGLE_CALENDAR_CREDENTIALS_PATH=/app/credentials/google_service_account.json
GOOGLE_CALENDAR_DEFAULT_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
USE_MOCK_GOOGLE_CALENDAR=true

# Admin Dashboard Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Admin Credentials for Initial Seed
DEFAULT_ADMIN_EMAIL=admin@clinic.com
DEFAULT_ADMIN_PASSWORD=AdminSecurePass123!
