# ==========================================
# HealthAI Assistant Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=HealthAI-Assistant
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_super_secret_64_char_random_key_in_production
WEBHOOK_SECRET=healthai_webhook_secret_for_n8n_and_openwa

# Database Configuration (PostgreSQL)
POSTGRES_USER=healthai
POSTGRES_PASSWORD=healthai_secure_pass
POSTGRES_DB=healthai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://healthai:healthai_secure_pass@postgres:5432/healthai_db
SYNC_DATABASE_URL=postgresql://healthai:healthai_secure_pass@postgres:5432/healthai_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# n8n Orchestration Engine
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_secure_password
N8N_ENCRYPTION_KEY=super_secret_n8n_encryption_key_32chars
WEBHOOK_URL=http://localhost:5678/

# OpenWA WhatsApp Gateway
OPENWA_PORT=8080
OPENWA_API_KEY=openwa_secure_api_key_123
OPENWA_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-inbound
OPENWA_SESSION_NAME=clinic-assistant

# LLM / Ollama Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Calendar Configuration
GOOGLE_CALENDAR_CREDENTIALS_PATH=/app/credentials/google_service_account.json
GOOGLE_CALENDAR_DEFAULT_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
USE_MOCK_GOOGLE_CALENDAR=true

# Admin Dashboard Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Admin Credentials for Initial Seed
DEFAULT_ADMIN_EMAIL=admin@clinic.com
DEFAULT_ADMIN_PASSWORD=AdminSecurePass123!
