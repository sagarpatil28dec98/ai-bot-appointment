      "webhookId": "whatsapp-inbound-hook"
    },
    {
      "parameters": {
        "functionCode": "// Normalize incoming WhatsApp message structure\nconst body = items[0].json.body || items[0].json;\n\n// Handle OpenWA standard event payloads\nlet senderPhone = body.from ? body.from.replace('@c.us', '') : '';\nlet messageText = body.body || body.content || '';\nlet senderName = (body.sender && body.sender.pushname) ? body.sender.pushname : 'WhatsApp Patient';\n\nreturn [{\n  json: {\n    from_number: senderPhone,\n    message_text: messageText,\n    sender_name: senderName,\n    message_id: body.id || ''\n  }\n}];"
      },
      "name": "Transform Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://fastapi:8000/api/v1/chat/message",
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "from_number",
              "value": "={{$node[\"Transform Payload\"].json[\"from_number\"]}}"
            },
            {
              "name": "message_text",
              "value": "={{$node[\"Transform Payload\"].json[\"message_text\"]}}"
            },
            {
